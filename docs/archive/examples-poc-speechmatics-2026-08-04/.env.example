# Kopiera denna fil till .env och fyll i dina egna nycklar
# .env far ALDRIG committas — den ligger i .gitignore

# Speechmatics — hamta pa portal.speechmatics.com efter registrering
SPEECHMATICS_API_KEY=

# DeepL — hamta pa deepl.com/pro-api (valj Free API-plan for gratis 500k tecken/man)
DEEPL_API_KEY=

# Port som PoC-servern lyssnar pa
PORT=8080
